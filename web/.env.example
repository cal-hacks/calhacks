# Google Identity Services OAuth client ID (Web application type).
# Leave empty to use the built-in demo Google sign-in.
VITE_GOOGLE_CLIENT_ID=

# Agent service (FastAPI) base URL. Empty means port 8000 on whatever host
# served the page. When set, Outlook/Apple calendar "Connect" buttons also
# redirect to `${VITE_AGENT_API_URL}/oauth/<provider>/start`.
VITE_AGENT_API_URL=

# Live group (SpacetimeDB). Empty URI means port 3000 on whatever host served
# the page. For Maincloud: wss://maincloud.spacetimedb.com and your database name.
VITE_SPACETIMEDB_URI=
VITE_SPACETIMEDB_DB=calhacks
