# Google Sign-In (optional). Without these, "Continue with Google" runs a demo flow.
# iOS client ID from Google Cloud Console → Credentials → OAuth client ID (iOS).
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# Web client ID (needed to receive an ID token for the backend).
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Agent service (FastAPI) base URL, for syncing once the backend is up.
EXPO_PUBLIC_AGENT_API_URL=
