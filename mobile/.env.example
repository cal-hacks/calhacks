# Google Sign-In (optional). Without these, "Continue with Google" runs a demo flow.
# iOS client ID from Google Cloud Console → Credentials → OAuth client ID (iOS).
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# Web client ID (needed to receive an ID token for the backend).
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Agent service (agent/). Defaults to http://localhost:8000 in development.
EXPO_PUBLIC_AGENT_API_URL=
# Must match ORBIT_SHARED_SECRET in agent/.env, if set.
EXPO_PUBLIC_AGENT_KEY=

# Build-time: your Apple Developer team ID. Turns on Apple Screen Time
# (needs a real iPhone; App Store builds also need Apple's Family Controls approval).
APPLE_TEAM_ID=
