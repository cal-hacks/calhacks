# SpacetimeDB
SPACETIMEDB_URI=http://localhost:3000
SPACETIMEDB_DB_NAME=calhacks
# Owner token (spacetime login show --token). The agent service needs it to read private tables.
SPACETIMEDB_TOKEN=

# Claude
ANTHROPIC_API_KEY=

# Agent service: web app origins allowed to call it (comma-separated). Requests carry a
# bearer token, not cookies, so * is fine; phones use the Mac's LAN address.
WEB_ORIGINS=*

# Fetch.ai agents: any long random string. It fixes the agents' addresses, so keep it stable and secret.
FETCH_AGENT_SEED=
FETCH_PORT=8001
# Optional: lets `python -m agent_service.connect_agentverse` connect the mailboxes for you.
AGENTVERSE_API_KEY=

# Where the agent service keeps friends' Google Calendar tokens (default: agent/.google_tokens.json)
GOOGLE_TOKEN_FILE=

# Google Calendar sign-in run by the agent service (keeps a refresh token).
# Same OAuth client as web's VITE_GOOGLE_CLIENT_ID. Add AGENT_PUBLIC_URL/oauth/google/callback
# to the client's authorized redirect URIs.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# This service's public URL (https://... on Render). Locally: http://localhost:8000
AGENT_PUBLIC_URL=
